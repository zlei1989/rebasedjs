{
  "name": "@tiegongji/web",
  "version": "0.1.0",
  "private": true,
  "main": "electron/dist/main.js",
  "scripts": {
    "dev": "tsx watch server.ts",
    "dev:electron": "tsx watch server.ts & sleep 3 && electron .",
    "build": "next build",
    "build:electron": "next build && electron-builder",
    "start": "tsx server.ts",
    "typecheck": "tsc --noEmit",
    "format": "eslint . --fix",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@ant-design/plots": "^2.6.8",
    "@ant-design/x": "^2.9.0",
    "@ant-design/x-markdown": "^2.9.0",
    "@tiegongji/agent-sdk": "workspace:*",
    "@tiegongji/protocol-sdk": "workspace:*",
    "antd": "^6.5.3",
    "autoprefixer": "^10.4.0",
    "dayjs": "^1.11.21",
    "next": "16.2.7",
    "node-sqlite3-wasm": "^0.8.58",
    "normalize.css": "^8.0.1",
    "postcss": "^8.4.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "simple-git": "^3.31.0",
    "tailwindcss": "^3.4.0",
    "ws": "^8.21.2",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@testing-library/react": "^16.3.2",
    "@types/eslint-plugin-tailwindcss": "^3.17.0",
    "@types/node": "^20",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.10",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "eslint-plugin-tailwindcss": "^3.17.0",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.8"
  }
